# =============================================================================
# Abdallah AI – environment variables
# Copy to `.env` (backend, repo root or backend/) and `frontend/.env.local` (frontend).
# Placeholders only. NEVER commit real values.
# =============================================================================

# ----------------------------- Backend (FastAPI) -----------------------------

# Runtime environment: development | staging | production | test
APP_ENV=development

# Comma-separated list of browser origins allowed to call the API (CORS).
# In production, set this to the deployed frontend URL only.
CORS_ORIGINS=http://localhost:3000

# Directory holding the Markdown knowledge base. Relative paths resolve against backend/.
KNOWLEDGE_BASE_DIR=../knowledge_base

# ----------------------------- LLM (backend only) ----------------------------
# Provider: fake | openai_compatible | anthropic. `fake` streams a canned demo answer and
# needs no key, so the app runs out of the box.
LLM_PROVIDER=fake

# openai_compatible works with Groq, OpenRouter, OpenAI and Ollama via the base URL, e.g.
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Secret. Lives only in .env on the server; never in the frontend, logs or git.
LLM_API_KEY=your-provider-api-key

LLM_MODEL=openai/gpt-oss-120b
# Retried once if the main model fails with 429/5xx/timeout BEFORE any text was streamed.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# For reasoning models (gpt-oss, o-series): low | medium | high. Leave empty to not send it
# (required for models that do not support the parameter). Reasoning is never shown or logged.
LLM_REASONING_EFFORT=low

# Optional: a different reasoning effort for Arabic replies (falls back to the one above).
LLM_REASONING_EFFORT_AR=

LLM_MAX_OUTPUT_TOKENS=500
LLM_TEMPERATURE=0.3
# Seconds without any data from the provider before the request fails with a friendly error.
LLM_TIMEOUT_SECONDS=30
# Limit-aware routing: skip a model BEFORE sending when its remaining tokens per minute (from
# Groq's x-ratelimit headers) do not cover the prompt + this many tokens.
LLM_ROUTE_HEADROOM_TOKENS=300

# USD per million tokens, only for cost estimates (logs and evals). Check your provider's
# current price list; these are Groq's published gpt-oss-120b prices at the time of writing.
LLM_INPUT_COST_PER_MTOK=0.15
LLM_OUTPUT_COST_PER_MTOK=0.60

# ----------------------------- Retrieval (RAG) -------------------------------
# onnx = small multilingual ONNX model run locally (int8, 118 MB; no API cost, small enough for
# a serverless bundle); fake = offline hashing (tests only).
RAG_EMBEDDER=onnx
# Chosen by evals/run_retrieval (Arabic + English): Recall@6 1.0 in both languages.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Model files (`uv run python -m app.rag.cli download-models`) and the precomputed index
# artifact (`... build`; rebuilt automatically when the knowledge changes). Relative paths
# resolve against backend/. Both are gitignored; Vercel builds them in the build step.
RAG_MODELS_DIR=.models
RAG_INDEX_DIR=.index
# Small budget on purpose (keeps cost/latency low and fits Groq's free tier). Recall of what
# the chat sends is 1.0 on evals/run_retrieval at 6 chunks / 1000 tokens (4 chunks lose cases).
RAG_TOP_K=6
RAG_MAX_CONTEXT_TOKENS=1000
# Model-specific minimum cosine similarity for vector hits (0.25 suits MiniLM; re-tune per model).
RAG_MIN_SCORE=0.25

# --------------------------- Shared state (serverless) ---------------------------
# Upstash Redis REST API for rate limits, daily caps, the TTS budget and the answer cache, shared
# by every serverless instance. Empty = in memory (one local process). The Vercel Marketplace
# integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which are read too. Never commit values.
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Read the client IP from X-Real-IP / X-Forwarded-For (only behind a trusted proxy; automatic
# on Vercel, which sets VERCEL=1).
TRUST_PROXY_HEADERS=false

# ------------------------------- Answer cache --------------------------------
# First-turn answers (and their TTS audio) are reused; keyed by question + language +
# knowledge hash + prompt version. The suggestion chips are pre-warmed at startup.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_DIR=.cache/answers
ANSWER_CACHE_MAX_ENTRIES=500
ANSWER_CACHE_PREWARM=true
# Delay before pre-warming (a `--reload` restart within it cancels the pre-warm).
ANSWER_CACHE_PREWARM_DELAY_SECONDS=30
ANSWER_CACHE_STREAM_DELAY_MS=15

# ----------------------- Chat abuse and cost protection ----------------------
# Per visitor IP, plus a global cap across all visitors (UTC day). Over limit -> HTTP 429.
# APP_ENV=development multiplies the per-IP limits (not the global caps) by 5.
CHAT_RATE_PER_MINUTE=8
CHAT_RATE_PER_DAY=60
CHAT_MAX_REQUESTS_PER_DAY=500

# ----------------------------- Voice (backend only) --------------------------
# Speech-to-text: fake | groq. `groq` = Whisper via the OpenAI-compatible
# /audio/transcriptions endpoint and reuses LLM_BASE_URL and LLM_API_KEY above.
STT_PROVIDER=fake
# whisper-large-v3 (most accurate for Arabic + English) or whisper-large-v3-turbo (cheaper).
STT_MODEL=whisper-large-v3
STT_TIMEOUT_SECONDS=20

# Text-to-speech: fake | browser | elevenlabs. `browser` = the visitor's own speechSynthesis
# (free, no key). If ElevenLabs fails or its quota runs out, that answer falls back to it.
TTS_PROVIDER=browser
TTS_MODEL=eleven_v4_turbo
# Public ElevenLabs premade voice ids (not secrets); one multilingual voice serves both.
# iP95p4xoKVk53GoZ742B = "Chris" (male; Arabic among its ElevenLabs-verified languages).
TTS_VOICE_EN=iP95p4xoKVk53GoZ742B
TTS_VOICE_AR=iP95p4xoKVk53GoZ742B
TTS_TIMEOUT_SECONDS=15
# Secret. Lives only in .env on the server; never in the frontend, logs or git.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Per-IP limits (transcribe; speak = one call per sentence) and a global daily budget of
# synthesized characters that protects the TTS free tier (over it -> browser voice).
VOICE_RATE_PER_MINUTE=6
TTS_RATE_PER_MINUTE=40
TTS_MAX_CHARS_PER_DAY=20000

# ----------------------------- Frontend (Next.js) ----------------------------
# NEXT_PUBLIC_* values are embedded in the browser bundle, so never put secrets here.

# Base URL of the FastAPI backend as seen by the BROWSER, without a trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL of the FastAPI backend as seen by the Next.js SERVER (server components).
# Server-only (no NEXT_PUBLIC_ prefix); can be an internal address. Falls back to the public URL.
API_BASE_URL=http://localhost:8000

# Public URL of the website, used for absolute URLs in metadata (Open Graph).
SITE_URL=http://localhost:3000

# Default UI language and text direction: en/ltr or ar/rtl.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Voice input: milliseconds of silence that end a spoken question (500–5000, default 1100).
NEXT_PUBLIC_VAD_SILENCE_MS=1100
